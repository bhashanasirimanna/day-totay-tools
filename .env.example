# Copy to .env (local) and set the same values in your host's environment settings (e.g. Vercel).
# Every variable below is NEXT_PUBLIC_, which means it is embedded in the browser bundle at build time.
# Never put secrets (API keys, tokens, passwords) in a NEXT_PUBLIC_ variable.

# Public site URL, no trailing slash. Used for canonicals, sitemap, robots and Open Graph.
# If unset or still a placeholder, the code falls back to https://toolbunch.tools.
NEXT_PUBLIC_SITE_URL=https://toolbunch.tools

# URL of the LibreOffice converter service (see converter/README.md), for high-fidelity PDF to Word.
# If unset, PDF to Word falls back to a basic text-only converter in the browser.
NEXT_PUBLIC_CONVERTER_URL=

# AdSense publisher ID, e.g. ca-pub-1234567890123456. Leave empty to show placeholders instead of ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
